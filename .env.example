# ===================================================================
# LogiTrack IQ - Environment Variables (Example)
#
# Copy this file to .env and fill in actual values.
# Never commit .env with real credentials to Git.
# ===================================================================

# ===================================================================
# Database
# ===================================================================
DB_URL=jdbc:mysql://localhost:3307/logitrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=utf-8
DB_USERNAME=logitrack
DB_PASSWORD=logitrack123

# ===================================================================
# JWT Security
# ===================================================================
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd
JWT_EXPIRATION_MS=86400000

# ===================================================================
# Spring Configuration
# ===================================================================
SQL_INIT_MODE=always
SERVER_PORT=8080
TZ=America/Bogota

# ===================================================================
# MCP Server (Model Context Protocol)
# ===================================================================
# URL where the MCP server connects to the LogiTrack API
LOGITRACK_API_URL=http://localhost:8080

# MCP Server host and port
MCP_HOST=127.0.0.1
MCP_PORT=3001

# Agent user credentials for MCP authentication
# Must exist in the database with AGENTE role
AGENTE_USERNAME=agente
AGENTE_PASSWORD=admin123

# Optional: MCP authentication token (if required by configuration)
# MCP_AUTH_TOKEN=

# ===================================================================
# Docker Compose
# ===================================================================
# Uncomment when using docker-compose:
# DB_URL=jdbc:mysql://mysql:3306/logitrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=utf-8
